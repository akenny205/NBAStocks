{
  "name": "nbastocks",
  "version": "0.1.0",
  "bin": {
    "nbastocks": "dist/cli.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "npm run build:cli",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-friends": "tsx scripts/seed-friends.ts",
    "db:price": "tsx scripts/price-players.ts",
    "db:tickers": "tsx scripts/generate-tickers.ts",
    "cli": "tsx scripts/terminal.ts",
    "build:cli": "esbuild scripts/terminal.ts --bundle --platform=node --outfile=dist/cli.js --external:@prisma/client --banner:js='#!/usr/bin/env node'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/adapter-neon": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "csv-parse": "^6.2.1",
    "next": "16.1.1",
    "next-auth": "^5.0.0-beta.30",
    "prisma": "^7.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
